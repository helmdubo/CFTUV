        }
      },
      "required": [
        "$id_type",
        "value"
      ],
      "type": "object"
    },
    "SnappedSourcePositionV1": {
      "additionalProperties": false,
      "properties": {
        "$type": {
          "const": "SnappedSourcePositionV1"

      "required": [
        "$id_type",
        "value"
      ],
      "type": "object"
    },
    "TriangleGramV1": {
      "additionalProperties": false,
      "properties": {
        "$type": {
          "const": "TriangleGramV1"
        },
        "gram": {
          "$ref": "#/$defs/ExactMatrix2V1"
        },
        "triangle_id": {
          "$ref": "#/$defs/SurfaceTriangleId"
        }
      },
      "required": [
        "$type",
        "triangle_id",
        "gram"
      ],
      "type": "object"
    },
    "TriangleSquaredLengthsV1": {
      "additionalProperties": false,
      "properties": {
        "$type": {
          "const": "TriangleSquaredLengthsV1"
        },
        "side_0": {
          "$ref": "#/$defs/ExactRationalV1"
        },
        "side_1": {

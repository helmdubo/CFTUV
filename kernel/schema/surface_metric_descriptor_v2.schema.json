      ],
      "type": "object"
    },
    "SurfaceMetricDescriptorV2": {
      "additionalProperties": false,
      "properties": {
        "$type": {
          "const": "SurfaceMetricDescriptorV2"
        },
        "adjacency_ref": {
          "$ref": "#/$defs/SurfaceAdjacencyRefV1"
        },
        "barriers": {
          "items": {
            "$ref": "#/$defs/SurfaceBarrierV1"
          },
          "type": "array",
          "uniqueItems": true
        },
        "evaluation_law": {
          "enum": [
            "EVALUATED_TRIANGULATED_MESH_AFTER_SOURCE_SNAP_V1"

{
  "$defs": {
    "CertifiedDecimalIntervalV1": {
      "additionalProperties": false,
      "properties": {
        "$type": {
          "const": "CertifiedDecimalIntervalV1"
        },
        "absolute_error_bound": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "type": "string"
        },
        "lower": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "type": "string"
        },
        "lower_kind": {
          "enum": [
            "OPEN",
            "CLOSED"
          ],
          "type": "string"
        },
        "upper": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "type": "string"
        },
        "upper_kind": {
          "enum": [
            "OPEN",
            "CLOSED"
          ],
          "type": "string"
        }
      },
      "required": [
        "$type",
        "lower",
        "upper",
        "lower_kind",
        "upper_kind",
        "absolute_error_bound"
      ],
      "type": "object"
    },
    "DegenerateTriangleV1": {
      "additionalProperties": false,
      "properties": {
        "$type": {
          "const": "DegenerateTriangleV1"
        },
        "reason": {
          "enum": [
            "COINCIDENT_SNAPPED_VERTICES",
            "COLLINEAR_SNAPPED_VERTICES"
          ],
          "type": "string"
        },
        "triangle_id": {
          "$ref": "#/$defs/SurfaceTriangleId"
        }
      },
      "required": [
        "$type",
        "triangle_id",
        "reason"
      ],
      "type": "object"
    },
    "ExactMatrix2V1": {
      "additionalProperties": false,
      "properties": {
        "$type": {
          "const": "ExactMatrix2V1"
        },
        "m00": {
          "$ref": "#/$defs/ExactRationalV1"
        },
        "m01": {
          "$ref": "#/$defs/ExactRationalV1"
        },
        "m10": {
          "$ref": "#/$defs/ExactRationalV1"
        },
        "m11": {
          "$ref": "#/$defs/ExactRationalV1"
        }
      },
      "required": [
        "$type",
        "m00",
        "m01",
        "m10",
        "m11"
      ],
      "type": "object"
    },
    "ExactPoint3V1": {
      "additionalProperties": false,
      "properties": {
        "$type": {
          "const": "ExactPoint3V1"
        },
        "x": {
          "$ref": "#/$defs/ExactRationalV1"
        },
        "y": {
          "$ref": "#/$defs/ExactRationalV1"
        },
        "z": {
          "$ref": "#/$defs/ExactRationalV1"
        }
      },
      "required": [
        "$type",
        "x",
        "y",
        "z"
      ],
      "type": "object"
    },
    "ExactRationalV1": {
      "additionalProperties": false,
      "properties": {
        "$type": {
          "const": "ExactRationalV1"
        },
        "denominator": {
          "type": "integer"
        },
        "numerator": {
          "type": "integer"
        }
      },
      "required": [
        "$type",
        "numerator",
        "denominator"
      ],
      "type": "object"
    },
    "GridScaleTrialV1": {
      "additionalProperties": false,
      "properties": {
        "$type": {
          "const": "GridScaleTrialV1"
        },
        "outcome": {
          "enum": [
            "RELATIONS_RESTORED",
            "RELATIONS_NOT_RESTORED"
          ],
          "type": "string"
        },
        "restored_right_corners": {
          "type": "integer"
        },
        "scale": {
          "type": "integer"
        },
        "step": {
          "$ref": "#/$defs/ExactRationalV1"
        }
      },
      "required": [
        "$type",
        "scale",
        "step",
        "restored_right_corners",
        "outcome"
      ],
      "type": "object"
    },
    "IntegerGridCertificateV1": {
      "additionalProperties": false,
      "properties": {
        "$type": {
          "const": "IntegerGridCertificateV1"
        },
        "author_angular_error": {
          "$ref": "#/$defs/ExactRationalV1"
        },
        "decal_detail": {
          "$ref": "#/$defs/ExactRationalV1"
        },
        "intended_right_corners": {
          "type": "integer"
        },
        "magnitude_bound": {
          "oneOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "patch_extent": {
          "$ref": "#/$defs/ExactRationalV1"
        },
        "restored_right_corners": {
          "type": "integer"
        },
        "scale_trials": {
          "items": {
            "$ref": "#/$defs/GridScaleTrialV1"

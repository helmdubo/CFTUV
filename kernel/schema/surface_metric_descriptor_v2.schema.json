          "type": "array"
        },
        "search_order": {
          "enum": [
            "FINEST_ADMISSIBLE_FIRST_V1",
            "COARSEST_ADMISSIBLE_FIRST_V1"
          ],
          "type": "string"
        },
        "snapping_law": {
          "enum": [
            "UNSNAPPED_EXACT_V1",
            "SOURCE_ONLY_GRID_SNAP_V1",
            "INTEGER_GRID_SNAP_V1"
          ],
          "type": "string"
        },
        "source_scale": {
          "oneOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "window_lower_bound": {
          "$ref": "#/$defs/ExactRationalV1"
        },
        "window_outcome": {
          "enum": [
            "WINDOW_AVAILABLE",
            "GRID_WINDOW_CLOSED",
            "NO_POWER_OF_TWO_STEP_IN_WINDOW"
          ],
          "type": "string"
        },
        "window_step": {
          "oneOf": [
            {
              "$ref": "#/$defs/ExactRationalV1"
            },
            {
              "type": "null"
            }
          ]
        },
        "window_upper_bound": {
          "$ref": "#/$defs/ExactRationalV1"
        }
      },
      "required": [
        "$type",
        "snapping_law",
        "window_outcome",
        "patch_extent",
        "author_angular_error",
        "decal_detail",
        "window_lower_bound",
        "window_upper_bound",
        "window_step",
        "source_scale",
        "magnitude_bound",
        "intended_right_corners",
        "restored_right_corners",
        "search_order",
        "scale_trials"
      ],
      "type": "object"

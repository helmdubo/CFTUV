    "IntrinsicSurfaceGeometryV2": {
      "additionalProperties": false,
      "properties": {
        "$type": {
          "const": "IntrinsicSurfaceGeometryV2"
        },
        "degenerate_triangles": {
          "items": {
            "$ref": "#/$defs/DegenerateTriangleV1"
          },
          "type": "array",
          "uniqueItems": true
        },
        "triangle_gram_matrices": {
          "items": {
            "$ref": "#/$defs/TriangleGramV1"
          },
          "type": "array",
          "uniqueItems": true
        },
        "triangle_squared_lengths": {
          "items": {
            "$ref": "#/$defs/TriangleSquaredLengthsV1"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "$type",
        "triangle_squared_lengths",
        "triangle_gram_matrices",
        "degenerate_triangles"
      ],
      "type": "object"
    },
    "LawId": {
      "additionalProperties": false,
      "properties": {
        "$id_type": {
          "const": "LawId"
        },
        "value": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "$id_type",
        "value"
      ],
      "type": "object"
    },
    "NamedEpsilonV1": {
      "additionalProperties": false,
      "properties": {
        "$type": {
          "const": "NamedEpsilonV1"

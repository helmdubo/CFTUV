          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "type": "string"
        },
        "lower": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "type": "string"
        },
        "lower_kind": {
          "enum": [
            "OPEN",
            "CLOSED"
          ],
          "type": "string"
        },
        "upper": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "type": "string"
        },
        "upper_kind": {
          "enum": [
            "OPEN",
            "CLOSED"
          ],
          "type": "string"
        }
      },
      "required": [
        "$type",
        "lower",
        "upper",
        "lower_kind",
        "upper_kind",
        "absolute_error_bound"
      ],
      "type": "object"
    },
